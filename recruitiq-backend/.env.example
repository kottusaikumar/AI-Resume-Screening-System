# Runtime
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Authentication. Generate AUTH_SECRET with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=60
BOOTSTRAP_ORG_NAME=Local Organization
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Browser and host allow-lists
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Storage and privacy
# DATABASE_PATH=./data/recruitiq.db
STORE_RESUME_PREVIEW=false
BLIND_SCREENING_DEFAULT=true

# Upload limits
MAX_UPLOAD_MB=10
MAX_BULK_TOTAL_MB=50
MAX_BULK_RESUMES=10
MAX_BULK_JOB_DESCRIPTIONS=10
MAX_BULK_JD_TOTAL_CHARS=200000
MAX_TEXT_FIELD_CHARS=50000

# Scanned-PDF OCR limits (runs locally, only when embedded text is unavailable)
PDF_OCR_ENABLED=true
PDF_OCR_MIN_TEXT_CHARS=40
PDF_OCR_MAX_PAGES=5
PDF_OCR_DPI=110
PDF_OCR_MAX_PIXELS_PER_PAGE=12000000

# Local model configuration (no external inference API)
USE_NEURAL_EMBEDDINGS=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set this to an audited Hugging Face commit hash before deployment.
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# Optional local enhancements. Keep disabled on a 512MB free backend.
USE_SPACY=false

ANALYZE_RATE_LIMIT=10/minute
DEFAULT_RATE_LIMIT=60/minute
